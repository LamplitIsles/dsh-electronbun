{
  "name": "dsh-electronbun",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Windows x64 DSH desktop host built with Electrobun",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run prepare:sdk && tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build:supervisor": "bun run scripts/build-supervisor.ts",
    "test:zig": "zig test supervisor/src/command_line.zig && zig test supervisor/src/windows_impl.zig",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/native-lifecycle-gate.ps1",
    "test:packaging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/packaging-smoke.ps1",
    "prepare:sdk": "bun run scripts/prepare-sdk.ts",
    "build": "bun run scripts/build-release.ts stable",
    "build:dev": "bun run scripts/build-release.ts dev",
    "build:stable": "bun run scripts/build-release.ts stable",
    "dev": "bun run scripts/dev.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "electrobun": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.8.3"
  }
}
